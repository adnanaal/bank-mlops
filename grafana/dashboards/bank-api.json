          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), r.endpoint || ' ' || r.http_status || ' ' || r.error_code AS metric, count(*) AS value FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) AND r.http_status >= 400 GROUP BY 1, 2 ORDER BY 1"
