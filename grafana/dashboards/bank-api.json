      },
      "description": "Compteur d'activité, pas une mesure CPU.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.worker_pid AS pid, left(r.instance_id::text, 8) AS instance, count(*) AS requetes, min(r.started_at) AS premiere, max(r.started_at) AS derniere FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) GROUP BY 1, 2 ORDER BY derniere DESC"
