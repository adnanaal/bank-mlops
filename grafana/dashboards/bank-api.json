          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.item_count::text AS taille, count(*) AS requetes FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) AND r.endpoint = '/predict/batch' AND r.http_status = 200 GROUP BY r.item_count ORDER BY r.item_count"
        }
