    {
      "id": 1,
      "title": "Requêtes (tentatives)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bank-api-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS requetes FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "pas de données",
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      }
    },
    {
      "id": 2,
      "title": "Taux d'erreur",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bank-api-postgres"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN NULL ELSE 100.0 * avg((r.http_status >= 400)::int) END AS erreurs FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "pas de données",
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      }
    },
    {
      "id": 3,
      "title": "Clients scorés (succès)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bank-api-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(r.item_count), 0) AS clients FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) AND r.http_status = 200 AND r.endpoint <> '/feedback'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "pas de données",
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      }
    },
    {
      "id": 4,
      "title": "Version servie (dernière prédiction)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bank-api-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT mv.registered_name || ' v' || mv.version || ' (' || coalesce(mv.qualification, '?') || ')' AS version FROM tracing.predictions p JOIN tracing.model_versions mv USING (model_id) JOIN tracing.api_requests r USING (request_id) WHERE $__timeFilter(p.created_at) AND r.campaign_id IN ($campaign) ORDER BY p.created_at DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "pas de données",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      }
    },
    {
      "id": 5,
      "title": "p95 traitement /predict",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bank-api-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY r.processing_duration_ms) AS p95 FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint = '/predict' AND r.http_status = 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "pas de données",
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      }
    },
    {
      "id": 6,
      "title": "Requêtes par seconde (succès et tentatives)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bank-api-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), r.endpoint || CASE WHEN r.http_status < 400 THEN ' succès' ELSE ' erreur' END AS metric, count(*) / ($__interval_ms / 1000.0) AS value FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "pas de données",
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "insertNulls": 600000,
            "spanNulls": false,
            "showPoints": "auto",
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {}
    },
