    {
      "id": 14,
      "title": "Feedbacks : volume, avis favorables, couverture",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bank-api-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 7
      },
      "description": "Cohorte : prédictions de la fenêtre ; retours éventuellement reçus plus tard.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH cohorte AS (SELECT p.prediction_id FROM tracing.predictions p JOIN tracing.api_requests r USING (request_id) WHERE $__timeFilter(p.created_at) AND r.campaign_id IN ($campaign)) SELECT (SELECT count(*) FROM cohorte) AS predictions_cohorte, count(f.feedback_id) AS feedbacks_recus, CASE WHEN count(f.useful) = 0 THEN NULL ELSE round(100.0 * avg(f.useful::int), 1) END AS pct_utiles, CASE WHEN (SELECT count(*) FROM cohorte) = 0 THEN NULL ELSE round(100.0 * count(f.feedback_id) / (SELECT count(*) FROM cohorte), 2) END AS couverture_pct FROM cohorte c LEFT JOIN tracing.feedbacks f USING (prediction_id)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Qualité observée (labels réels, hors loadtest/synthétiques)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bank-api-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 6
      },
      "description": "Population auto-sélectionnée : interpréter avec l'effectif. Vide si aucun label réel.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT mv.registered_name || ' v' || mv.version AS version, count(*) AS labels_observes, CASE WHEN count(*) = 0 THEN NULL ELSE round(100.0 * avg((p.predicted_label = f.observed_label)::int), 1) END AS classement_correct_pct FROM tracing.feedbacks f JOIN tracing.predictions p USING (prediction_id) JOIN tracing.model_versions mv USING (model_id) WHERE $__timeFilter(p.created_at) AND f.observed_label IS NOT NULL AND f.label_source NOT IN ('loadtest', 'synthetic-course') GROUP BY 1"
        }
      ],
