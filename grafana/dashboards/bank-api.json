    {
      "id": 9,
      "title": "Durée de traitement p50 / p95 / p99 (ms) par endpoint",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bank-api-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "description": "Durée serveur (validation + inférence), hors transaction de traçabilité et réseau.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bank-api-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), r.endpoint || ' ' || q.name AS metric, percentile_cont(q.p) WITHIN GROUP (ORDER BY r.processing_duration_ms) AS value FROM tracing.api_requests r CROSS JOIN (VALUES ('p50', 0.5), ('p95', 0.95), ('p99', 0.99)) AS q(name, p) WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) AND r.http_status < 400 GROUP BY 1, 2, q.p ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "pas de données",
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "insertNulls": 600000,
            "spanNulls": false,
            "showPoints": "auto",
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {}
    },
