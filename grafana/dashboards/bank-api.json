          "rawSql": "SELECT $__timeGroupAlias(r.started_at, $__interval), r.endpoint AS metric, percentile_cont(0.95) WITHIN GROUP (ORDER BY r.inference_duration_ms) AS value FROM tracing.api_requests r WHERE $__timeFilter(r.started_at) AND r.campaign_id IN ($campaign) AND r.endpoint IN ($endpoint) AND r.inference_duration_ms IS NOT NULL GROUP BY 1, 2 ORDER BY 1"
