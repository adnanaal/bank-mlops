# Copier en .env à côté de compose.yml (le .env n'est jamais versionné).
# Valeurs de démonstration pour une stack liée à 127.0.0.1 uniquement.
MLFLOW_PORT=7281
PREFECT_PORT=4200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=5mlde-local-admin
# 15432 pour éviter un éventuel PostgreSQL local déjà installé sur 5432
POSTGRES_PORT=15432
POSTGRES_PASSWORD=5mlde-local-postgres
API_DB_PASSWORD=5mlde-local-api
GRAFANA_DB_PASSWORD=5mlde-local-grafana
